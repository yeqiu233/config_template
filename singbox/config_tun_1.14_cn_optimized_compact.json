      {"type": "logical", "mode": "and", "rules": [{"inbound": "tun-in", "clash_mode": "rule", "network": "tcp", "port": [80, 443]}, {"rule_set": ["geosite-cn"]}, {"rule_set": ["geoip-cn"]}, {"rule_set": ["geosite-chat", "geosite-youtube", "geosite-github", "geosite-google", "geoip-google", "geosite-telegram", "geoip-telegram", "geosite-tiktok", "geosite-netflix", "geoip-netflix", "geosite-apple", "geoip-apple", "geosite-onedrive", "geosite-microsoft", "geosite-geolocation-!cn"], "invert": true}], "action": "bypass"},
      {"action": "sniff"},
      {"protocol": "dns", "action": "hijack-dns"},
      {"inbound": ["tun-in", "mixed-in"], "preferred_by": "tailscale", "action": "route", "outbound": "tailscale"},
      {"clash_mode": "direct", "action": "route", "outbound": "🎯 全球直连"},
      {"clash_mode": "global", "action": "route", "outbound": "GLOBAL"},
      {"clash_mode": "rule", "rule_set": ["cn-app-wechat", "cn-app-payment", "geosite-bank-cn", "cn-app-shopping", "cn-app-media", "cn-app-life", "cn-app-office"], "action": "route", "outbound": "🎯 全球直连"},
