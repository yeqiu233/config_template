{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {
    "disabled": false,
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {"type": "hosts", "tag": "dns_bootstrap", "predefined": {"dns.alidns.com": ["223.5.5.5", "223.6.6.6"], "dns.google": ["8.8.8.8", "8.8.4.4"]}},
      {"type": "https", "tag": "dns_direct", "server": "dns.alidns.com", "server_port": 443, "path": "/dns-query", "domain_resolver": "dns_bootstrap", "tls": {"server_name": "dns.alidns.com"}},
      {"type": "https", "tag": "dns_proxy", "server": "dns.google", "server_port": 443, "path": "/dns-query", "domain_resolver": "dns_bootstrap", "tls": {"server_name": "dns.google"}, "detour": "🚀 节点选择"},
      {"type": "https", "tag": "dns_global", "server": "dns.google", "server_port": 443, "path": "/dns-query", "domain_resolver": "dns_bootstrap", "tls": {"server_name": "dns.google"}, "detour": "GLOBAL"},
      {"type": "local", "tag": "dns_local"},
      {"type": "tailscale", "tag": "dns-tailscale", "endpoint": "tailscale", "accept_default_resolvers": false, "accept_search_domain": true}
    ],
    "rules": [
      {"preferred_by": "dns-tailscale", "disable_optimistic_cache": true, "action": "route", "server": "dns-tailscale"},
      {"preferred_by": "dns_bootstrap", "action": "route", "server": "dns_bootstrap"},
      {"preferred_by": "dns_local", "disable_optimistic_cache": true, "action": "route", "server": "dns_local"},
      {"clash_mode": "direct", "action": "route", "server": "dns_direct"},
      {"clash_mode": "global", "action": "route", "server": "dns_global"},
      {"rule_set": ["cn-app-wechat", "cn-app-payment", "geosite-bank-cn"], "action": "route", "server": "dns_direct", "disable_optimistic_cache": true},
      {"rule_set": ["cn-app-shopping", "cn-app-media", "cn-app-life", "cn-app-office"], "action": "route", "server": "dns_direct"},
      {"rule_set": ["geosite-chat", "geosite-youtube", "geosite-github", "geosite-google", "geosite-telegram", "geosite-tiktok", "geosite-netflix", "geosite-onedrive", "geosite-microsoft"], "action": "route", "server": "dns_proxy"},
      {"rule_set": ["geosite-apple"], "action": "route", "server": "dns_direct"},
      {"rule_set": ["geosite-geolocation-!cn"], "action": "route", "server": "dns_proxy"},
      {"rule_set": ["geosite-cn"], "action": "route", "server": "dns_direct"},
      {"query_type": ["A", "AAAA"], "action": "evaluate", "server": "dns_proxy"},
      {"query_type": ["A", "AAAA"], "match_response": true, "rule_set": ["geoip-cn"], "action": "route", "server": "dns_direct"}
    ],
    "final": "dns_proxy",
    "strategy": "prefer_ipv4",
    "cache_capacity": 8192,
    "timeout": "5s",
    "optimistic": {
      "enabled": true,
      "timeout": "30m"
    },
    "reverse_mapping": true
  },
  "ntp": {},
  "certificate": {},
  "certificate_providers": [],
  "http_clients": [
    {"tag": "http_direct", "version": 2, "domain_resolver": "dns_direct"},
    {"tag": "http_proxy", "version": 2, "detour": "🚀 节点选择"}
  ],
  "network_namespaces": [],
  "endpoints": [
    {
      "type": "tailscale",
      "tag": "tailscale",
      "state_directory": "/etc/sing-box/tailscale",
      "hostname": "singbox-server",
      "ephemeral": false,
      "accept_routes": true,
      "advertise_routes": ["192.168.200.0/24"],
      "advertise_exit_node": true,
      "system_interface": false,
      "listen_port": 41641
    }
  ],
  "inbounds": [
    {
      "tag": "tun-in",
      "type": "tun",
      "interface_name": "utun0",
      "address": ["172.19.0.1/30", "fdfe:dcba:9876::1/126"],
      "mtu": 1500,
      "auto_route": true,
      "auto_redirect": true,
      "dns_mode": "hijack",
      "strict_route": true,
      "stack": "mixed"
    },
    {
      "tag": "mixed-in",
      "type": "mixed",
      "listen": "0.0.0.0",
      "listen_port": 7893,
      "tcp_fast_open": true,
      "tcp_multi_path": true,
      "udp_fragment": true
    }
  ],
